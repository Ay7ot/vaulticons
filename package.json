{
  "name": "vaulticons-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the VaultIcons icon library and documentation site.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vaulticons/docs",
    "build": "npm run build -w @vaulticons/core",
    "build:docs": "npm run build -w @vaulticons/docs"
