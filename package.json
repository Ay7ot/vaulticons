  "keywords": [
    "react",
    "icons",
    "fintech",
    "crypto",
    "svg",
    "typescript"
  ],
  "author": "Ayomide Ibiteye",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
